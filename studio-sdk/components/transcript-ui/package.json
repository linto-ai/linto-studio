{
  "name": "@linto-ai/transcript-ui",
  "version": "0.9.0",
  "description": "Vue 3 components for displaying and interacting with a transcript — batteries-included entry point (core + UI kit + i18n)",
  "keywords": [
    "vue",
    "vue3",
    "transcript",
    "transcription",
    "linto"
  ],
  "sideEffects": false,
  "homepage": "https://github.com/linto-ai/linto-studio",
  "bugs": "https://github.com/linto-ai/linto-studio/issues",
  "author": "Tom Darboux <tdarboux@linagora.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/linto-ai/linto-studio.git",
    "directory": ""
  },
  "type": "module",
  "license": "AGPL-3.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun run --cwd packages/playground dev",
    "build": "vue-tsc -b && vite build",
    "build:wc": "bun run --cwd packages/webcomponent build",
    "preview": "bun run --cwd packages/playground preview",
    "test": "bun test"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@linto-ai/transcript-ui-core": "workspace:*",
    "@linto-ai/transcript-ui-i18n": "workspace:*",
    "@linto-ai/transcript-ui-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  }
}
