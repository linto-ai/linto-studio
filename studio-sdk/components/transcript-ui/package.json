{
  "name": "@linto/transcript-ui",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0",
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "bun run --cwd packages/playground dev",
    "build": "vue-tsc -b && vite build",
    "build:wc": "bun run --cwd packages/webcomponent build",
    "preview": "bun run --cwd packages/playground preview",
    "test": "bun test"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@linto/transcript-ui-core": "workspace:*",
    "@linto/transcript-ui-i18n": "workspace:*",
    "@linto/transcript-ui-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.25",
    "vue-tsc": "^3.1.5"
  }
}
