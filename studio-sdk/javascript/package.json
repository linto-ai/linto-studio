  },
  "homepage": "linto.ai",
  "type": "module",
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
