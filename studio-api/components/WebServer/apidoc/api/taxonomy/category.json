{
  "/api/conversations/{conversationId}/categories": {
    "post": {
      "tags": ["conversations taxonomy"],
      "summary": "Create a category in the organization of a conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "color": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["highlight", "conversation_metadata"]
                }
              },
              "required": ["name", "type"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Category created"
                  }
                }
              },
              "example": {
                "message": "Category created"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "409": {
          "$ref": "#/components/responses/Conflict"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    },
    "get": {
      "tags": ["conversations taxonomy"],
      "summary": "Retrieve all categories from the organization of a conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "in": "query",
          "name": "type",
          "required": false,
          "schema": {
            "$ref": "#/components/schemas/CategoryType"
          }
        },
        {
          "in": "query",
          "name": "expand",
          "required": false,
          "description": "Expand the result with their linked tags"
        },
        {
          "in": "query",
          "name": "possess",
          "required": false,
          "description": "With expand=true on highlight categories, only return tags present on the conversation (with their metadata)",
          "schema": {
            "type": "string",
            "enum": ["true", "false"]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/Category"
                }
              }
            }
          }
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/categories/{categoryId}": {
    "get": {
      "tags": ["conversations taxonomy"],
      "summary": "Retrieve a category from the organization of a conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/CategoryId"
        },
        {
          "in": "query",
          "name": "metadata",
          "required": false,
          "description": "Show metadata from tag related to the conversation ",
          "example": "true"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/Category"
              }
            }
          }
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/categories/search": {
    "get": {
      "tags": ["conversations taxonomy"],
      "summary": "Search categories based on the specified search type",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "in": "query",
          "name": "type",
          "required": true,
          "schema": {
            "$ref": "#/components/schemas/CategorySearchType"
          },
          "description": "Research type:\n * `explore` - Disabled for a conversation search \n * `info` - Retrieve information for all desired tags with their category information (`tags`, `name`) \n * `category` - Search for any category based on the provided name (`name`)\n"
        },
        {
          "in": "query",
          "name": "tags",
          "required": false,
          "description": "List of tags id to search for",
          "example": "5e9b1b9b0f9b2c0017b5f1b5,5e9b1b9b0f9b2c0017b5f1b6,..."
        },
        {
          "in": "query",
          "name": "categories",
          "required": false,
          "description": "List of categories id to search for",
          "example": "5e9b1b9b0f9b2c0017b5f1b5,5e9b1b9b0f9b2c0017b5f1b6,..."
        },
        {
          "in": "query",
          "name": "name",
          "required": false,
          "description": "Search for a name on tags or categories based on the search type"
        },
        {
          "in": "query",
          "name": "expand",
          "required": false,
          "description": "Expand the result with their linked tags (only use for `explore` type)"
        },
        {
          "in": "query",
          "name": "categoryType",
          "required": false,
          "description": "CategoryType to search, this have the priority over the tags and categories parameters",
          "example": "highlight,conversation_metadata"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/CategoryWithTags"
                }
              }
            }
          }
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        }
      }
    }
  }
}
