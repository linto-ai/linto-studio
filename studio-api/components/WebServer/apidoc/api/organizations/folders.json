{
  "/api/organizations/{organizationId}/folders": {
    "get": {
      "tags": ["organizations members"],
      "summary": "List folders for an organization",
      "description": "Retrieve all folders belonging to an organization. Supports tree mode, filtering by parentId, and optional conversation count.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "tree",
          "required": false,
          "description": "If 'true', returns the folder hierarchy as a nested tree using $graphLookup",
          "schema": {
            "type": "string",
            "enum": ["true", "false"]
          }
        },
        {
          "in": "query",
          "name": "parentId",
          "required": false,
          "description": "Filter folders by parent ID. Use 'null' to get root folders only.",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "withConversationCount",
          "required": false,
          "description": "If 'true', includes the number of conversations in each folder",
          "schema": {
            "type": "string",
            "enum": ["true", "false"]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FolderWithCount"
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    },
    "post": {
      "tags": ["organizations members"],
      "summary": "Create a folder in an organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Folder name (max 255 characters)"
                },
                "parentId": {
                  "type": "string",
                  "nullable": true,
                  "description": "Parent folder ID. Null or omitted for root folder."
                },
                "color": {
                  "type": "string",
                  "nullable": true,
                  "description": "Hex color code (e.g. #3498db)"
                },
                "emoji": {
                  "type": "string",
                  "nullable": true,
                  "description": "Unified emoji code (e.g. 1F4C1)"
                },
                "position": {
                  "type": "number",
                  "description": "Sort position among siblings (default 0)"
                },
                "visibility": {
                  "type": "string",
                  "enum": ["public", "private"],
                  "default": "public",
                  "description": "Visibility of the folder"
                },
                "members": {
                  "type": "array",
                  "description": "Members with access when the folder is private",
                  "items": {
                    "type": "object",
                    "properties": {
                      "userId": {
                        "type": "string"
                      },
                      "right": {
                        "type": "integer",
                        "description": "Access right level"
                      }
                    }
                  }
                }
              },
              "required": ["name"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Folder created",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Folder"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/folders/{folderId}": {
    "get": {
      "tags": ["organizations members"],
      "summary": "Retrieve a folder by ID",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/FolderId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Folder"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "patch": {
      "tags": ["organizations members"],
      "summary": "Update a folder",
      "description": "Update folder properties. If parentId is changed, anti-cycle detection is performed to prevent moving a folder into one of its descendants.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/FolderId"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Folder name (max 255 characters)"
                },
                "parentId": {
                  "type": "string",
                  "nullable": true,
                  "description": "New parent folder ID. Set to null to move to root. Anti-cycle detection is enforced."
                },
                "color": {
                  "type": "string",
                  "nullable": true,
                  "description": "Hex color code (e.g. #3498db)"
                },
                "emoji": {
                  "type": "string",
                  "nullable": true,
                  "description": "Unified emoji code (e.g. 1F4C1)"
                },
                "position": {
                  "type": "number",
                  "description": "Sort position among siblings"
                },
                "visibility": {
                  "type": "string",
                  "enum": ["public", "private"],
                  "description": "New visibility of the folder"
                },
                "members": {
                  "type": "array",
                  "description": "Members with access when the folder is private",
                  "items": {
                    "type": "object",
                    "properties": {
                      "userId": {
                        "type": "string"
                      },
                      "right": {
                        "type": "integer",
                        "description": "Access right level"
                      }
                    }
                  }
                },
                "force": {
                  "type": "boolean",
                  "description": "Required to make a folder public when its parent is private"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Folder updated",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Folder"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "422": {
          "description": "Cycle detected - cannot move a folder into one of its descendants",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "error": {
                    "type": "string",
                    "example": "Cannot move a folder into one of its descendants"
                  }
                }
              }
            }
          }
        }
      }
    },
    "delete": {
      "tags": ["organizations maintainers"],
      "summary": "Delete a folder",
      "description": "Delete a folder. By default (strategy=move_to_parent), child folders and conversations are reparented to the deleted folder's parent.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/FolderId"
        },
        {
          "in": "query",
          "name": "strategy",
          "required": false,
          "description": "Deletion strategy. 'move_to_parent' (default) reparents children and conversations to the parent folder.",
          "schema": {
            "type": "string",
            "enum": ["move_to_parent"],
            "default": "move_to_parent"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Folder deleted",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "message": "Folder deleted"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/folders/{folderId}/conversations": {
    "get": {
      "tags": ["organizations members"],
      "summary": "List conversations in a folder",
      "description": "Retrieve conversations belonging to a specific folder, with support for pagination, sorting, and filtering by tags/text.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/FolderId"
        },
        {
          "$ref": "#/components/parameters/Page"
        },
        {
          "$ref": "#/components/parameters/Size"
        },
        {
          "$ref": "#/components/parameters/SortField"
        },
        {
          "$ref": "#/components/parameters/SortCriteria"
        },
        {
          "in": "query",
          "name": "tags",
          "required": false,
          "description": "Comma-separated list of tag IDs to filter by",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "name",
          "required": false,
          "description": "Filter conversations by name",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "text",
          "required": false,
          "description": "Full-text search in conversation content",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "processing",
          "required": false,
          "description": "Filter conversations by transcription job state",
          "schema": {
            "type": "string",
            "enum": ["pending", "processing", "queued", "done", "error"]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "count": {
                    "type": "number"
                  },
                  "list": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/ConversationList"
                    }
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/folders/{folderId}/conversations/{conversationId}": {
    "post": {
      "tags": ["organizations members"],
      "summary": "Move a conversation to a folder",
      "description": "Move a single conversation into a specific folder. The conversation rights are synchronized with the folder visibility.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/FolderId"
        },
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "responses": {
        "200": {
          "description": "Conversation moved",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "message": "Conversation moved"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/folders/uncategorized/conversations": {
    "post": {
      "tags": ["organizations members"],
      "summary": "Remove conversations from their folder",
      "description": "Batch remove multiple conversations from their current folder. The conversations become uncategorized.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "conversationIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "List of conversation IDs to remove from their folder"
                }
              },
              "required": ["conversationIds"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Conversations removed from folder",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "message": "Conversations removed from folder"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
