{
  "/api/organizations/{organizationId}/tags": {
    "get": {
      "tags": ["organizations members"],
      "summary": "List the tags of a category in the organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "categoryId",
          "required": true,
          "description": "Category from which tags are listed",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "withMediaCount",
          "required": false,
          "description": "Include the number of conversations using each tag",
          "schema": {
            "type": "boolean"
          }
        },
        {
          "in": "query",
          "name": "folderId",
          "required": false,
          "description": "Restrict the media count to a folder",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Tag"
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "post": {
      "tags": ["organizations members"],
      "summary": "Create a tag for an organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "categoryId": {
                  "type": "string"
                },
                "organizationId": {
                  "type": "string",
                  "description": "Organization owning the tag"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the tag"
                },
                "color": {
                  "type": "string",
                  "description": "Hex color of the tag, format #rrggbb"
                },
                "emoji": {
                  "type": "string",
                  "description": "Emoji unified code, format [0-9a-f]{5,6}"
                }
              },
              "required": ["organizationId", "categoryId"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Tag created"
                  }
                }
              },
              "example": {
                "message": "Tag created"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "409": {
          "$ref": "#/components/responses/Conflict"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/tags/search": {
    "get": {
      "tags": ["organizations members"],
      "summary": "Find related tags",
      "description": "Returns the tags of a category that are used on the same conversations as the given tags.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "tags",
          "required": true,
          "description": "Comma separated list of tag ids",
          "example": "5e9b1b9b0f9b2c0017b5f1b5,5e9b1b9b0f9b2c0017b5f1b6,..."
        },
        {
          "in": "query",
          "name": "categoryId",
          "required": true,
          "description": "Category of the returned tags",
          "example": "5e9b1b9b0f9b2c0017b5f1b5"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/TagList"
              }
            }
          }
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/tags/{tagId}": {
    "get": {
      "tags": ["organizations members"],
      "summary": "Retrieve a tag by ID",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TagId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/Tag"
              }
            }
          }
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    },
    "patch": {
      "tags": ["organizations members"],
      "summary": "Update a tag",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TagId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "categoryId": {
                  "type": "string"
                },
                "organizationId": {
                  "type": "string",
                  "description": "Organization owning the tag"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the tag"
                },
                "color": {
                  "type": "string",
                  "description": "Hex color of the tag, format #rrggbb"
                },
                "emoji": {
                  "type": "string",
                  "description": "Emoji unified code, format [0-9a-f]{5,6}"
                }
              },
              "required": ["organizationId", "categoryId"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Tag updated"
                  }
                }
              },
              "example": {
                "message": "Tag updated"
              }
            }
          }
        },
        "304": {
          "$ref": "#/components/responses/NotModified"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "409": {
          "$ref": "#/components/responses/Conflict"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    },
    "delete": {
      "tags": ["organizations maintainers"],
      "summary": "Delete a tag",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TagId"
        }
      ],
      "responses": {
        "200": {
          "$ref": "#/components/responses/OK"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
