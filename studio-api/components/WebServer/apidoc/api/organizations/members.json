{
  "/api/organizations/{organizationId}/": {
    "get": {
      "tags": ["organizations members"],
      "summary": "Retrieve organization information",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "includeM2m",
          "required": false,
          "description": "When 'true', include M2M (API key) users in the member list",
          "schema": {
            "type": "string",
            "enum": ["true", "false"]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/Organization"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/self": {
    "delete": {
      "tags": ["organizations members"],
      "summary": "Leave the requested organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Information"
                  }
                }
              },
              "example": {
                "message": "You have leaved the organization"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations": {
    "get": {
      "tags": ["organizations members"],
      "summary": "List all conversations of an organization where the user has access",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "filter",
          "required": false,
          "description": "Allow to filter some data (`notags`)",
          "example": ""
        },
        {
          "in": "query",
          "name": "tags",
          "required": false,
          "description": "List of tags id to search for",
          "example": "5e9b1b9b0f9b2c0017b5f1b5,5e9b1b9b0f9b2c0017b5f1b6,..."
        },
        {
          "in": "query",
          "name": "name",
          "required": false,
          "description": "Search for a conversation name"
        },
        {
          "in": "query",
          "name": "text",
          "required": false,
          "description": "Search for a text inside the conversation"
        },
        {
          "in": "query",
          "name": "folderId",
          "required": false,
          "description": "Filter conversations by folder id, or 'null' for conversations without a folder"
        },
        {
          "in": "query",
          "name": "processing",
          "required": false,
          "description": "Filter conversations by transcription job state",
          "schema": {
            "type": "string",
            "enum": ["pending", "processing", "queued", "done", "error"]
          }
        },
        {
          "$ref": "#/components/parameters/Page"
        },
        {
          "$ref": "#/components/parameters/Size"
        },
        {
          "$ref": "#/components/parameters/SortField"
        },
        {
          "$ref": "#/components/parameters/SortCriteria"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            }
          }
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
