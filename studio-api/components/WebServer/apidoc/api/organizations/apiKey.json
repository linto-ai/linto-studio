{
  "/api/organizations/{organizationId}/tokens/": {
    "post": {
      "tags": ["organizations admin"],
      "summary": "Create an API key token for the organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "integer"
                },
                "expires_in": {
                  "type": "string",
                  "description": "Duration until the token expires (e.g., 5y, 30d, 12h)",
                  "default": "14d"
                },
                "metadata": {
                  "type": "string",
                  "description": "Metadata of the key: a JSON string (multipart) or a JSON object (application/json body). Recognised keys: `externalIdentity` {provider, subject, email} — the external person the key stands for (unique per (provider, subject) in the organization, email lowercased); `quickMeeting` (boolean, default true) — whether the key may start a quick meeting; anything else (e.g. `plan`) is stored as is.",
                  "example": "{\"externalIdentity\":{\"provider\":\"twake\",\"subject\":\"jdoe\",\"email\":\"jdoe@twake.app\"},\"quickMeeting\":true,\"plan\":{\"isPaying\":true}}"
                }
              },
              "required": ["role"]
            }
          },
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "integer"
                },
                "expires_in": {
                  "type": "string",
                  "default": "14d"
                },
                "metadata": {
                  "type": "object",
                  "description": "Same keys as the multipart form, as an object"
                }
              },
              "required": ["role"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/APIToken"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "409": {
          "$ref": "#/components/responses/Conflict"
        }
      },
      "description": "`409 external_identity_conflict` when a key already stands for the same `externalIdentity` (provider, subject) in this organization."
    },
    "get": {
      "tags": ["organizations admin"],
      "summary": "Retrieve all API keys of the organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "externalSubject",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Only the keys standing for this external identity, as `<provider>:<subject>` (e.g. `twake:jdoe`)"
        },
        {
          "in": "query",
          "name": "externalEmail",
          "required": false,
          "schema": {
            "type": "string"
          },
          "description": "Only the keys whose external identity carries this email (case-insensitive)"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/APIUser"
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/tokens/{tokenId}": {
    "put": {
      "tags": ["organizations admin"],
      "summary": "Regenerate an API key token",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TokenId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "expires_in": {
                  "type": "string",
                  "description": "Duration until the token expires (e.g., 5y, 30d, 12h)",
                  "default": "14d"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/APIToken"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "get": {
      "tags": ["organizations admin"],
      "summary": "Retrieve details of a specific API key token",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TokenId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/APIToken"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "delete": {
      "tags": ["organizations admin"],
      "summary": "Delete an API key",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TokenId"
        },
        {
          "in": "query",
          "name": "revoke",
          "required": false,
          "description": "Allow to disable or revoke the API key. If revoke=true, it does not delete, but disables. Default to false"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message"
                  }
                }
              },
              "example": {
                "message": "Api key has been deleted"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "patch": {
      "tags": ["organizations admin"],
      "summary": "Update an API key name and/or metadata",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TokenId"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "New display name of the API key"
                },
                "metadata": {
                  "type": "object",
                  "description": "Metadata keys to merge into the key's metadata (e.g. `plan`, `quickMeeting`). `externalIdentity`, `createdBy` and `organizationId` are immutable."
                }
              },
              "required": [],
              "description": "At least one of name / metadata"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "message": "API key updated",
                "name": "my secret key"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/tokens/{tokenId}/picture": {
    "put": {
      "tags": ["organizations admin"],
      "summary": "Upload an avatar picture for an API key",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TokenId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "format": "binary",
                  "description": "Image file (jpeg, png, ...)"
                }
              },
              "required": ["file"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    },
    "delete": {
      "tags": ["organizations admin"],
      "summary": "Remove the avatar picture of an API key",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/TokenId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "message": "API key picture removed"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
