{
  "/api/organizations/{organizationId}/": {
    "patch": {
      "tags": ["organizations admin"],
      "summary": "Update the organization information",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "mediaRetention": {
                  "type": "object",
                  "nullable": true,
                  "description": "How long the media created in the organization are kept. Each media gets its deletion date (expiresAt) when it is created, then it is deleted with its audio once the date is over. Changing the setting does not change the date of the media already created. null removes the retention: the media created afterwards are kept indefinitely, which is the default. Sent as JSON",
                  "properties": {
                    "value": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 120
                    },
                    "unit": {
                      "type": "string",
                      "enum": ["hour", "day", "week", "month", "year"]
                    }
                  },
                  "required": ["value", "unit"],
                  "example": { "value": 6, "unit": "month" }
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message"
                  }
                }
              },
              "example": {
                "message": "Organization has been updated"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "delete": {
      "tags": ["organizations admin"],
      "summary": "Delete an organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message"
                  }
                }
              },
              "example": {
                "message": "Organization has been deleted"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
