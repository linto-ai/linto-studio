{
  "/api/organizations/{organizationId}/conversations/create/": {
    "post": {
      "tags": ["organizations uploader"],
      "summary": "Create a new conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "file",
                  "format": "binary",
                  "description": "Audio file to convert into a conversation Either file or url must be provided."
                },
                "url": {
                  "type": "string",
                  "description": "URL of the media to transcribe (alternative to file)"
                },
                "name": {
                  "type": "string",
                  "description": "Name of the conversation"
                },
                "endpoint": {
                  "type": "string",
                  "description": "Endpoint of the conversation (can fetch information from service api)"
                },
                "lang": {
                  "type": "string",
                  "description": "Language of the conversation"
                },
                "transcriptionConfig": {
                  "$ref": "#/components/schemas/TranscriptionConfig"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the conversation"
                },
                "membersRight": {
                  "type": "integer",
                  "description": "Right access of organization members"
                },
                "segmentCharSize": {
                  "type": "integer",
                  "description": "Size of the segment in characters"
                },
                "securityLevel": {
                  "$ref": "#/components/schemas/SecurityLevel"
                },
                "folderId": {
                  "type": "string",
                  "description": "Folder in which the conversation is created ('null' accepted)"
                },
                "segmentWordSize": {
                  "type": "integer",
                  "description": "Maximum number of words per segment"
                },
                "sharedWithUsers": {
                  "type": "string",
                  "description": "Users to share the conversation with"
                }
              },
              "required": ["name", "endpoint", "lang"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "A conversation is currently being processed"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations/{conversationId}/regenerate": {
    "get": {
      "tags": ["organizations uploader"],
      "summary": "Regenerate a conversation based on the original transcription settings",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "A conversation is currently being processed"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations/import?type=transcription": {
    "post": {
      "tags": ["organizations uploader"],
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "type",
          "required": true,
          "description": "Type of import",
          "schema": {
            "type": "string",
            "enum": ["transcription"]
          }
        }
      ],
      "summary": "Import a conversation from an external transcription file",
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the conversation"
                },
                "lang": {
                  "type": "string",
                  "description": "Language of the conversation"
                },
                "transcription": {
                  "$ref": "#/components/schemas/TranscriptionModel"
                },
                "file": {
                  "type": "file",
                  "format": "binary",
                  "description": "Audio file to convert into a conversation"
                },
                "transcriptionConfig": {
                  "$ref": "#/components/schemas/TranscriptionConfig"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the conversation"
                },
                "membersRight": {
                  "type": "integer",
                  "description": "Right access of organization members"
                },
                "segmentCharSize": {
                  "type": "integer",
                  "description": "Size of the segment in characters"
                },
                "securityLevel": {
                  "$ref": "#/components/schemas/SecurityLevel"
                },
                "segmentWordSize": {
                  "type": "integer",
                  "description": "Maximum number of words per segment"
                },
                "folderId": {
                  "type": "string",
                  "description": "Folder in which the conversation is created"
                },
                "sharedWithUsers": {
                  "type": "string",
                  "description": "Users to share the conversation with"
                }
              },
              "required": ["name", "endpoint", "lang"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Conversation imported"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations/import?type=conversation": {
    "post": {
      "tags": ["organizations uploader"],
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "type",
          "required": true,
          "description": "Type of import",
          "schema": {
            "type": "string",
            "enum": ["conversation"]
          }
        }
      ],
      "summary": "Import a previously exported conversation",
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "file",
                  "format": "binary",
                  "description": "Media file of the conversation (optional)"
                },
                "conversation": {
                  "$ref": "#/components/schemas/Conversation",
                  "description": "JSON-encoded conversation export to import (name and locale are validated inside)"
                }
              },
              "required": ["conversation"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Conversation imported"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  }
}
