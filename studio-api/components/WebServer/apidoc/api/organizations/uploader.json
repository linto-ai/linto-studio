{
  "/api/organizations/{organizationId}/conversations/create/": {
    "post": {
      "tags": ["organizations uploader"],
      "summary": "Create a new conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "file",
                  "format": "binary",
                  "description": "Audio file to convert into a conversation Either file or url must be provided."
                },
                "url": {
                  "type": "string",
                  "description": "URL of the media to transcribe (alternative to file)"
                },
                "name": {
                  "type": "string",
                  "description": "Name of the conversation"
                },
                "endpoint": {
                  "type": "string",
                  "description": "Endpoint of the conversation (can fetch information from service api)"
                },
                "lang": {
                  "type": "string",
                  "description": "Language of the conversation"
                },
                "transcriptionConfig": {
                  "$ref": "#/components/schemas/TranscriptionConfig"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the conversation"
                },
                "membersRight": {
                  "type": "integer",
                  "description": "Right access of organization members"
                },
                "segmentCharSize": {
                  "type": "integer",
                  "description": "Size of the segment in characters"
                },
                "securityLevel": {
                  "$ref": "#/components/schemas/SecurityLevel"
                },
                "folderId": {
                  "type": "string",
                  "description": "Folder in which the conversation is created ('null' accepted)"
                },
                "segmentWordSize": {
                  "type": "integer",
                  "description": "Maximum number of words per segment"
                },
                "sharedWithUsers": {
                  "type": "string",
                  "description": "Users to share the conversation with"
                },
                "partial": {
                  "type": "boolean",
                  "description": "The file is the beginning of the audio: the conversation stays pending and open to append until it is completed. Requires a file, not a url"
                }
              },
              "required": ["name", "endpoint", "lang"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "A conversation is currently being processed"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations/{conversationId}/regenerate": {
    "get": {
      "tags": ["organizations uploader"],
      "summary": "Regenerate a conversation based on the original transcription settings",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "A conversation is currently being processed"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations/{conversationId}/append": {
    "post": {
      "tags": ["organizations uploader"],
      "summary": "Append the next audio to a conversation created with partial, or close it",
      "description": "The audio is transcribed with the settings of the conversation and joined to its audio, whose duration grows accordingly. Appended audios keep the order their requests arrived in, in the audio as in the transcription. With complete, the conversation is closed: no audio can be appended afterwards and it is done once every appended audio is transcribed. A request needs a file, complete, or both.",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "file",
                  "format": "binary",
                  "description": "Audio that follows the ones already sent. Optional when complete is true"
                },
                "complete": {
                  "type": "boolean",
                  "default": false,
                  "description": "Closes the conversation, after the audio of the request when there is one. A refused audio leaves it open"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  },
                  "conversationId": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "message": "The audio is being processed and will follow the previous ones",
                "conversationId": "6501a2b3c4d5e6f708091a2b"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations/import?type=transcription": {
    "post": {
      "tags": ["organizations uploader"],
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "type",
          "required": true,
          "description": "Type of import",
          "schema": {
            "type": "string",
            "enum": ["transcription"]
          }
        }
      ],
      "summary": "Import a conversation from an external transcription file",
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the conversation"
                },
                "lang": {
                  "type": "string",
                  "description": "Language of the conversation"
                },
                "transcription": {
                  "$ref": "#/components/schemas/TranscriptionModel"
                },
                "file": {
                  "type": "file",
                  "format": "binary",
                  "description": "Audio file to convert into a conversation"
                },
                "transcriptionConfig": {
                  "$ref": "#/components/schemas/TranscriptionConfig"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the conversation"
                },
                "membersRight": {
                  "type": "integer",
                  "description": "Right access of organization members"
                },
                "segmentCharSize": {
                  "type": "integer",
                  "description": "Size of the segment in characters"
                },
                "securityLevel": {
                  "$ref": "#/components/schemas/SecurityLevel"
                },
                "segmentWordSize": {
                  "type": "integer",
                  "description": "Maximum number of words per segment"
                },
                "folderId": {
                  "type": "string",
                  "description": "Folder in which the conversation is created"
                },
                "sharedWithUsers": {
                  "type": "string",
                  "description": "Users to share the conversation with"
                }
              },
              "required": ["name", "endpoint", "lang"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Conversation imported"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/organizations/{organizationId}/conversations/import?type=conversation": {
    "post": {
      "tags": ["organizations uploader"],
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "type",
          "required": true,
          "description": "Type of import",
          "schema": {
            "type": "string",
            "enum": ["conversation"]
          }
        }
      ],
      "summary": "Import a previously exported conversation",
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "file",
                  "format": "binary",
                  "description": "Media file of the conversation (optional)"
                },
                "conversation": {
                  "$ref": "#/components/schemas/Conversation",
                  "description": "JSON-encoded conversation export to import (name and locale are validated inside)"
                }
              },
              "required": ["conversation"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Conversation imported"
              }
            }
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  }
}
