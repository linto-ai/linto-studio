{
  "/api/publication/organizations/{organizationId}/templates": {
    "get": {
      "tags": ["publication"],
      "summary": "List the publication templates of an organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "query",
          "name": "service_id",
          "required": false,
          "description": "Restrict to the templates linked to this service",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "The list of templates",
          "content": {
            "application/json": {}
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "503": {
          "description": "LLM gateway unreachable"
        }
      }
    },
    "post": {
      "tags": ["publication"],
      "summary": "Upload a new publication template",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "format": "binary",
                  "description": "Template file (.docx)"
                },
                "name_fr": {
                  "type": "string",
                  "description": "French name of the template"
                },
                "name_en": {
                  "type": "string",
                  "description": "English name of the template"
                },
                "description_fr": {
                  "type": "string",
                  "description": "French description"
                },
                "description_en": {
                  "type": "string",
                  "description": "English description"
                },
                "scope": {
                  "type": "string",
                  "enum": ["personal", "organization"],
                  "default": "personal",
                  "description": "Visibility scope of the template"
                }
              },
              "required": ["file", "name_fr"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Created",
          "content": {
            "application/json": {}
          }
        },
        "400": {
          "$ref": "#/components/responses/BadRequest"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "503": {
          "description": "LLM gateway unreachable"
        }
      }
    }
  },
  "/api/publication/organizations/{organizationId}/templates/{templateId}": {
    "delete": {
      "tags": ["publication"],
      "summary": "Delete a publication template",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "path",
          "name": "templateId",
          "type": "string",
          "required": true,
          "description": "Template ID"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {}
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "503": {
          "description": "LLM gateway unreachable"
        }
      }
    }
  },
  "/api/publication/organizations/{organizationId}/templates/{templateId}/placeholders": {
    "get": {
      "tags": ["publication"],
      "summary": "List the placeholders of a publication template",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "in": "path",
          "name": "templateId",
          "type": "string",
          "required": true,
          "description": "Template ID"
        }
      ],
      "responses": {
        "200": {
          "description": "The list of placeholders",
          "content": {
            "application/json": {}
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "503": {
          "description": "LLM gateway unreachable"
        }
      }
    }
  },
  "/api/publication/conversations/{conversationId}/jobs/{jobId}/export/{format}": {
    "get": {
      "tags": ["publication"],
      "summary": "Export an LLM job result with a publication template",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/JobId"
        },
        {
          "in": "path",
          "name": "format",
          "required": true,
          "description": "Output format",
          "schema": {
            "type": "string",
            "enum": ["html", "pdf", "docx"]
          }
        },
        {
          "in": "query",
          "name": "templateId",
          "required": false,
          "description": "Publication template to use",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "placeholders",
          "required": false,
          "description": "JSON object mapping placeholder names to values",
          "schema": {
            "type": "string"
          }
        },
        {
          "in": "query",
          "name": "versionNumber",
          "required": false,
          "description": "Version of the job result to export",
          "schema": {
            "type": "integer"
          }
        },
        {
          "in": "query",
          "name": "timezone",
          "required": false,
          "description": "Timezone used to render dates",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "File download",
          "content": {
            "text/html": {},
            "application/pdf": {},
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document": {}
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "403": {
          "$ref": "#/components/responses/Forbidden"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "503": {
          "description": "LLM gateway unreachable"
        }
      }
    }
  }
}
