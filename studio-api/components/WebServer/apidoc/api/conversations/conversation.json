{
  "/api/conversations/shared": {
    "get": {
      "tags": ["conversations"],
      "summary": "List all conversations that have been shared with the connected user",
      "parameters": [
        {
          "$ref": "#/components/parameters/Size"
        },
        {
          "$ref": "#/components/parameters/Page"
        },
        {
          "$ref": "#/components/parameters/SortField"
        },
        {
          "$ref": "#/components/parameters/SortCriteria"
        },
        {
          "in": "query",
          "name": "name",
          "required": false,
          "description": "Search based on the conversation name"
        },
        {
          "in": "query",
          "name": "text",
          "required": false,
          "description": "Search if conversation contains text"
        },
        {
          "in": "query",
          "name": "description",
          "required": false,
          "description": "Search based on the conversation description"
        },
        {
          "in": "query",
          "name": "tags",
          "required": false,
          "description": "List of tags id to filter for",
          "example": "5e9b1b9b0f9b2c0017b5f1b5,5e9b1b9b0f9b2c0017b5f1b6,..."
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/invite": {
    "post": {
      "tags": ["conversations"],
      "summary": "Invite an external user to access the conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "right": {
                  "type": "integer",
                  "description": "Right of the user"
                },
                "notify": {
                  "type": "boolean",
                  "description": "When false, no invitation email is sent (default true)"
                }
              },
              "required": ["email"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Conversation updated"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/media": {
    "get": {
      "tags": ["conversations"],
      "summary": "Download media files (e.g. audio, transcription) from a conversation",
      "description": "Set response type to \"audio/mpeg\" to get the mp3 file, or to \"application/json\" to get audiowavesurfer json file.",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "audio/mpeg": {
              "schema": {
                "type": "file"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/child": {
    "get": {
      "tags": ["conversations member"],
      "summary": "Retrieve a conversation based on the parent ID",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "in": "query",
          "name": "projection",
          "required": false,
          "description": "Comma separated list of fields to return",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/ConversationList"
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/duplicate": {
    "post": {
      "tags": ["conversations member"],
      "summary": "Duplicate a conversation",
      "description": "Create a copy of the conversation owned by the current user. Shares are not duplicated.",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "responses": {
        "201": {
          "description": "Created",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  },
                  "conversationId": {
                    "type": "string"
                  }
                }
              },
              "example": {
                "message": "Conversation duplicated",
                "conversationId": "6392f74a32d603288c910185"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/conversations/users": {
    "post": {
      "tags": ["conversations member"],
      "summary": "List the users who have access to a list of conversations",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "conversations": {
                  "type": "string",
                  "description": "Comma separated list of conversation IDs",
                  "example": "6392f74a32d603288c910185,634eae867d29b677f13e7e6c"
                }
              },
              "required": ["conversations"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "conversationId": {
                      "type": "string"
                    },
                    "member": {
                      "type": "object",
                      "properties": {
                        "external_members": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/User"
                          }
                        },
                        "organization_members": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/User"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
