{
  "/api/conversations/{conversationId}/subtitle": {
    "post": {
      "tags": ["conversations subtitle member"],
      "summary": "Generate subtitle for a conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "screenCharSize": {
                  "type": "integer",
                  "description": "Number of character for a screen",
                  "example": "80"
                },
                "screenMaxDuration": {
                  "type": "integer",
                  "description": "Max duration for a screen in second",
                  "example": "5"
                },
                "screenLines": {
                  "type": "integer",
                  "description": "Number of line for a screen",
                  "example": "2"
                },
                "version": {
                  "description": "Version name of the subtitle",
                  "example": "conv-1.0"
                }
              },
              "required": ["version"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/ConversationSubtitle"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "get": {
      "tags": ["conversations subtitle member"],
      "summary": "List all subtitle versions of a conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/ConvSubtitleVersion"
                }
              }
            }
          }
        },
        "204": {
          "$ref": "#/components/responses/NoContent"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "delete": {
      "tags": ["conversations subtitle member"],
      "summary": "Delete subtitle versions of a conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "in": "query",
          "name": "subtitleId",
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "List of uuid string to remove separated with a , "
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Subtitle has been deleted"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/subtitle/{subtitleId}": {
    "get": {
      "tags": ["conversations subtitle member"],
      "summary": "Get a subtitle version of the conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/SubtitleId"
        },
        {
          "in": "query",
          "name": "type",
          "required": false,
          "description": "Subtitle output format: srt or vtt file download, JSON object when omitted",
          "schema": {
            "type": "string",
            "enum": ["srt", "vtt"]
          }
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "$ref": "#/components/schemas/ConversationSubtitle"
              }
            },
            "text/plain": {}
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "delete": {
      "tags": ["conversations subtitle member"],
      "summary": "Delete a subtitle version",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/SubtitleId"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Subtitle has been deleted"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "patch": {
      "tags": ["conversations subtitle member"],
      "summary": "Update the subtitle of a conversation",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/SubtitleId"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ConversationSubtitle"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Information about the conversation processus"
                  }
                }
              },
              "example": {
                "message": "Subtitle updated"
              }
            }
          }
        },
        "304": {
          "$ref": "#/components/responses/NotModified"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/subtitle/{subtitleId}/copy": {
    "post": {
      "tags": ["conversations subtitle member"],
      "summary": "Copy the desired subtitle to a new version",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/SubtitleId"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "version": {
                  "description": "Newer version name that will be created.",
                  "example": "conv-1.0"
                }
              },
              "required": ["version"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "A copy of the subtitle has been created"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/conversations/{conversationId}/subtitle/{subtitleId}/screen/{screenId}": {
    "delete": {
      "tags": ["conversations subtitle member"],
      "summary": "Delete the requested screen from a subtitle",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/SubtitleId"
        },
        {
          "in": "path",
          "name": "screenId",
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "uuid string identifier for the screen"
        }
      ],
      "responses": {
        "200": {
          "description": "OK"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "patch": {
      "tags": ["conversations subtitle member"],
      "summary": "Update the requested screen of a subtitle",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/SubtitleId"
        },
        {
          "in": "path",
          "name": "screenId",
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "uuid string identifier for the screen"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Screen"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK"
        },
        "304": {
          "$ref": "#/components/responses/NotModified"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    },
    "post": {
      "tags": ["conversations subtitle member"],
      "summary": "Add a screen after or before the selected screen id",
      "parameters": [
        {
          "$ref": "#/components/parameters/ConversationId"
        },
        {
          "$ref": "#/components/parameters/SubtitleId"
        },
        {
          "in": "path",
          "name": "screenId",
          "type": "string",
          "format": "uuid",
          "required": true,
          "description": "uuid string identifier for the screen"
        },
        {
          "in": "query",
          "name": "placement",
          "type": "string",
          "required": false,
          "value": "after",
          "description": "Allow to selection if the screen will go after or before the selected screen. Can have the value `after` or `before` (default value `after`)"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Screen"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_id": {
                    "type": "string",
                    "description": "Id of the created screen"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
