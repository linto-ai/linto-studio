{
  "/auth/login": {
    "post": {
      "tags": ["auth"],
      "summary": "Authenticate a user with email and password, returns a JWT bearer token",
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              },
              "required": ["email", "password"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/Authenticate"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/auth/login/magic-link": {
    "post": {
      "tags": ["auth"],
      "summary": "Authenticate a user with a magic link",
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "magicId": {
                  "type": "string"
                },
                "psw": {
                  "type": "string"
                }
              },
              "required": ["magicId", "psw"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "$ref": "#/components/responses/Authenticate"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/auth/logout": {
    "get": {
      "tags": ["auth"],
      "summary": "Log out the connected user",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "User has been disconnected"
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/auth/refresh": {
    "get": {
      "tags": ["auth"],
      "summary": "Refresh the user authentication token",
      "responses": {
        "200": {
          "$ref": "#/components/responses/Authenticate"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/auth/isAuth": {
    "get": {
      "tags": ["auth"],
      "summary": "Check whether the user is authenticated",
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "text/plain": {
              "schema": {
                "type": "string",
                "example": "Ok"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/auth/token": {
    "get": {
      "tags": ["auth"],
      "summary": "Generate a user token with a longer expiration time",
      "responses": {
        "200": {
          "$ref": "#/components/responses/Authenticate"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/auth/recovery": {
    "post": {
      "tags": ["auth"],
      "summary": "Send a magic link to recover user password",
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                }
              },
              "required": ["email"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "An email with an authentication link has been sent to you."
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "500": {
          "$ref": "#/components/responses/InternalServer"
        }
      }
    }
  },
  "/auth/list": {
    "get": {
      "tags": ["auth"],
      "summary": "List the enabled authentication methods",
      "responses": {
        "200": {
          "description": "The list of authentication",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "example": "local"
                    },
                    "from": {
                      "type": "string",
                      "example": "studio"
                    },
                    "name": {
                      "type": "string",
                      "example": "studio"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "/auth/resend-verification": {
    "post": {
      "tags": ["auth"],
      "summary": "Resend the account verification email",
      "description": "Always answers with a generic success message, whether the email exists or not.",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "description": "Email address of the account to verify"
                }
              },
              "required": ["email"]
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "example": {
                "message": "If this email exists and is not yet verified, a verification link has been sent."
              }
            }
          }
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  }
}
