{
  "/api/services": {
    "get": {
      "tags": ["services"],
      "summary": "List all running services from the gateway API",
      "parameters": [
        {
          "$ref": "#/components/parameters/SecurityLevel"
        }
      ],
      "responses": {
        "200": {
          "description": "The list of services",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Services"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  },
  "/api/services/{scope}": {
    "get": {
      "tags": ["services"],
      "summary": "List all running services from the gateway API",
      "parameters": [
        {
          "name": "scope",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "$ref": "#/components/parameters/SecurityLevel"
        }
      ],
      "responses": {
        "200": {
          "description": "The list of services",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Services"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  },
  "/api/services/{organizationId}/llm": {
    "get": {
      "tags": ["services"],
      "summary": "List the LLM services available to the organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/SecurityLevel"
        }
      ],
      "responses": {
        "200": {
          "description": "The list of llm services",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ServicesLlm"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  }
}
