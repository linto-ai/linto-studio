{
  "/api/administration/users": {
    "post": {
      "tags": ["administration users"],
      "summary": "Create a user",
      "parameters": [
        {
          "$ref": "#/components/parameters/UserScope"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "role": {
                  "type": "integer",
                  "default": "15"
                }
              },
              "required": ["email", "password", "role"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "Ok",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "User account created"
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Invalid email format or domain.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "409": {
          "$ref": "#/components/responses/Conflict"
        }
      }
    },
    "get": {
      "tags": ["administration users"],
      "summary": "List all users of the platform",
      "parameters": [
        {
          "$ref": "#/components/parameters/UserScope"
        },
        {
          "in": "query",
          "name": "name",
          "required": false,
          "description": "Filter users by first name (case-insensitive)"
        },
        {
          "in": "query",
          "name": "lastname",
          "required": false,
          "description": "Filter users by last name (case-insensitive)"
        },
        {
          "in": "query",
          "name": "email",
          "required": false,
          "description": "Filter users by email (case-insensitive)"
        },
        {
          "in": "query",
          "name": "type",
          "required": false,
          "description": "Filter users by account type"
        },
        {
          "$ref": "#/components/parameters/Page"
        },
        {
          "$ref": "#/components/parameters/Size"
        },
        {
          "$ref": "#/components/parameters/SortField"
        },
        {
          "$ref": "#/components/parameters/SortCriteria"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object",
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    },
    "delete": {
      "tags": ["administration users"],
      "summary": "Delete users by userIds",
      "parameters": [
        {
          "$ref": "#/components/parameters/UserScope"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "userIds": {
                  "type": "array",
                  "description": "List of user IDs to delete.",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["userIds"]
            }
          }
        }
      },
      "304": {
        "$ref": "#/components/responses/NotModified"
      },
      "401": {
        "$ref": "#/components/responses/Unauthorized"
      },
      "415": {
        "$ref": "#/components/responses/UnsupportedMediaType"
      }
    }
  },
  "/api/administration/users/{userId}": {
    "patch": {
      "tags": ["administration users"],
      "summary": "Update a user by ID",
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        },
        {
          "$ref": "#/components/parameters/UserScope"
        }
      ],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string"
                },
                "firstname": {
                  "type": "string"
                },
                "lastname": {
                  "type": "string"
                },
                "accountNotifications": {
                  "type": "object",
                  "properties": {
                    "updatePassword": {
                      "type": "boolean"
                    },
                    "inviteAccount": {
                      "type": "boolean"
                    }
                  }
                },
                "emailNotifications": {
                  "type": "object",
                  "schema": {
                    "$ref": "#/components/schemas/EmailNotification"
                  },
                  "example": {
                    "conversations": {
                      "share": {
                        "add": true,
                        "update": true,
                        "delete": true
                      }
                    },
                    "organizations": {
                      "add": true,
                      "delete": true,
                      "update": true
                    }
                  }
                },
                "role": {
                  "type": "integer",
                  "description": "Platform role of the user"
                },
                "password": {
                  "type": "string",
                  "description": "New password (hashed server side)"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "example": "User updated"
                  }
                }
              }
            }
          }
        },
        "304": {
          "$ref": "#/components/responses/NotModified"
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/administration/users/{userId}/organizations/": {
    "get": {
      "tags": ["administration users"],
      "summary": "List the organizations the user belongs to",
      "parameters": [
        {
          "$ref": "#/components/parameters/UserId"
        },
        {
          "$ref": "#/components/parameters/UserScope"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userOrganizations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "$ref": "#/components/schemas/OrganizationUsers"
                    }
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    }
  }
}
