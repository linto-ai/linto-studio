{
  "/api/administration/organizations": {
    "get": {
      "tags": ["administration organizations"],
      "summary": "List all organizations of the platform",
      "parameters": [
        {
          "$ref": "#/components/parameters/UserScope"
        },
        {
          "in": "query",
          "name": "name",
          "required": false,
          "description": "Filter organizations by name (case-insensitive)"
        },
        {
          "in": "query",
          "name": "matchingMail",
          "required": false,
          "description": "Filter organizations by matching mail domain"
        },
        {
          "in": "query",
          "name": "hidePersonal",
          "required": false,
          "description": "When 'true', exclude personal organizations",
          "schema": {
            "type": "string",
            "enum": ["true", "false"]
          }
        },
        {
          "$ref": "#/components/parameters/Page"
        },
        {
          "$ref": "#/components/parameters/Size"
        },
        {
          "$ref": "#/components/parameters/SortField"
        },
        {
          "$ref": "#/components/parameters/SortCriteria"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "userOrganizations": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "$ref": "#/components/schemas/OrganizationUsers"
                    }
                  }
                }
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        }
      }
    },
    "post": {
      "tags": ["administration organizations"],
      "summary": "Create an organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/UserScope"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the organization"
                },
                "permissions": {
                  "type": "integer"
                },
                "owner": {
                  "type": "string",
                  "description": "User id of the organization owner"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the organization"
                },
                "securityLevel": {
                  "$ref": "#/components/schemas/SecurityLevel"
                }
              },
              "required": ["name", "owner"]
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Organization xxxxxx created"
                  },
                  "organizationId": {
                    "type": "string",
                    "description": "Organization id"
                  }
                }
              },
              "example": {
                "message": "Organization test-norg-user created",
                "organizationId": "639312d5b36cdb549eb1deab"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "409": {
          "$ref": "#/components/responses/Conflict"
        },
        "415": {
          "$ref": "#/components/responses/UnsupportedMediaType"
        }
      }
    }
  },
  "/api/administration/organizations/{organizationId}/": {
    "patch": {
      "tags": ["administration organizations"],
      "summary": "Update the organization information",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/UserScope"
        }
      ],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "permissions": {
                  "type": "integer"
                },
                "matchingMail": {
                  "type": "string",
                  "description": "Mail domain automatically matching users to this organization (empty string to disable)"
                },
                "securityLevel": {
                  "$ref": "#/components/schemas/SecurityLevel"
                }
              }
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message"
                  }
                }
              },
              "example": {
                "message": "Organization has been updated"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  },
  "/api/administration/organizations/{organizationId}/inviteMatchingMail": {
    "post": {
      "tags": ["administration organizations"],
      "summary": "Invite the users with matching email to the organization",
      "parameters": [
        {
          "$ref": "#/components/parameters/OrganizationId"
        },
        {
          "$ref": "#/components/parameters/UserScope"
        }
      ],
      "responses": {
        "200": {
          "description": "OK",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "Message"
                  }
                }
              },
              "example": {
                "message": "Matching email users have been added to the organization"
              }
            }
          }
        },
        "401": {
          "$ref": "#/components/responses/Unauthorized"
        },
        "404": {
          "$ref": "#/components/responses/NotFound"
        }
      }
    }
  }
}
