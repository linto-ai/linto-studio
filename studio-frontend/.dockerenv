NODE_ENV=development
VUE_APP_PUBLIC_MEDIA=http://localhost:8001/media
VUE_APP_CONVO_API=http://localhost:8001/api
VUE_APP_CONVO_AUTH=http://localhost:8001/auth
VUE_APP_DEBUG=*
VUE_APP_STT_SERVICE_NAME=STT_NAME
VUE_APP_MULTIFILE=false
VUE_APP_TURN_SIZE=2000
VUE_APP_TURN_PER_PAGE=20
VUE_APP_MODE="cloud"
VUE_APP_SESSION_WS=http://localhost:8001/
VUE_APP_SESSION_WS_PATH=/socket.io/
VUE_APP_ENABLE_WATERMARK=true
# Disable user invitation
VUE_APP_DISABLE_USER_INVITATION=false
# Speaker identification / TTS
VUE_APP_ENABLE_SPEAKER_IDENTIFICATION=false
VUE_APP_ENABLE_TTS=false